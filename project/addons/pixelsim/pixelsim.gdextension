[configuration]
entry_symbol = "pixelsim_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/pixelsim/bin/libpixelsim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/pixelsim/bin/libpixelsim.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/pixelsim/bin/libpixelsim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/pixelsim/bin/libpixelsim.linux.template_release.x86_64.so"
macos.debug = "res://addons/pixelsim/bin/libpixelsim.macos.template_debug.framework"
macos.release = "res://addons/pixelsim/bin/libpixelsim.macos.template_release.framework"
